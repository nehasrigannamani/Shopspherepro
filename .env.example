# ---- Application -----------------------------------------------------------
APP_NAME=ShopSphere Pro
APP_ENV=development
DEBUG=true
# Base URL used when building links inside emails
PUBLIC_BASE_URL=http://localhost:8000

# ---- Database (MySQL 8) ----------------------------------------------------
DATABASE_URL=mysql+pymysql://shopsphere_user:CHANGE_ME@localhost:3306/shopsphere_pro

# ---- Authentication --------------------------------------------------------
# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=replace_with_a_random_secret_key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
EMAIL_VERIFICATION_EXPIRE_HOURS=48

# ---- Stripe (test mode) ----------------------------------------------------
# Secret key from  https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_replace_me
# Signing secret printed by:  stripe listen --forward-to localhost:8000/payments/webhook
STRIPE_WEBHOOK_SECRET=whsec_replace_me
STRIPE_SUCCESS_URL=http://localhost:8000/payment-success?session_id={CHECKOUT_SESSION_ID}
STRIPE_CANCEL_URL=http://localhost:8000/payment-cancelled

# ---- Email (set EMAIL_BACKEND=console in development to just log emails) ---
EMAIL_BACKEND=console
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_FROM_ADDRESS=no-reply@shopsphere.example
EMAIL_USE_TLS=true

# ---- SMS (optional; deliveries are only queued when SMS_PROVIDER_URL is set)
SMS_PROVIDER_URL=
SMS_PROVIDER_TOKEN=

# ---- Reports, background jobs ----------------------------------------------
EXPORT_DIR=exports
# true = run the scheduler inside the API process; otherwise call
# POST /report-exports/scheduler/run from cron
SCHEDULER_ENABLED=false
SCHEDULER_INTERVAL_SECONDS=60
JOB_MAX_ATTEMPTS=3

# ---- Audit -----------------------------------------------------------------
AUDIT_ENABLED=true
